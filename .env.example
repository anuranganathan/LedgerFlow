USE_AWS=false
AWS_REGION=ap-south-1
S3_BUCKET=payflow-receipts
SQS_QUEUE_URL=https://sqs.ap-south-1.amazonaws.com/123456789012/payflow-notifications

# Needed only when running Python outside Docker:
DATABASE_URL=postgresql+psycopg2://payflow:payflow@localhost:5432/payflow
REDIS_URL=redis://localhost:6379/0
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
